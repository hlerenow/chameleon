---
import Search from 'virtual:starlight/components/Search';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';

const base = '/chameleon/documents';
const links = [
  { label: '首页', href: `${base}/` },
  { label: '快速开始', href: `${base}/guides/` },
  { label: '编辑器', href: `${base}/guides/editor-basics/` },
  { label: 'Engine', href: `${base}/reference/engine/introduction/` },
  { label: '物料', href: `${base}/reference/material/introduction/` },
  { label: '插件', href: `${base}/reference/plugin/plugin-develop/` },
];
---

<div class="docs-header sl-flex">
  <div class="title-wrapper sl-flex">
    <img class="site-logo" src={`${base}/favicon.svg`} alt="" aria-hidden="true" />
    <SiteTitle />
  </div>

  <nav class="top-nav" aria-label="主导航">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>

  <div class="header-tools sl-flex print:hidden">
    <Search />
    <LanguageSelect />
    <div class="social-icons sl-flex"><SocialIcons /></div>
  </div>
</div>

<style>
  :global(:root) {
    color-scheme: dark;
  }
  :global(html),
  :global(body) {
    background: #050505;
  }
  :global(header.header) {
    background: linear-gradient(90deg, #020202 0%, #08050d 52%, #020202 100%);
    border-bottom-color: #221734;
    box-shadow: 0 1px 0 #7c3aed30, 0 14px 36px #00000080;
  }
  .docs-header {
    position: relative;
    height: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .docs-header::after {
    position: absolute;
    right: 18%;
    bottom: -1px;
    left: 18%;
    height: 1px;
    content: '';
    background: linear-gradient(90deg, transparent, #7c3aed80, transparent);
    pointer-events: none;
  }
  .title-wrapper {
    min-width: 11rem;
    align-items: center;
    gap: 0.55rem;
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
  }
  .site-logo {
    width: 3rem;
    height: 3rem;
    flex: none;
    filter: drop-shadow(0 0 10px #7c3aed55);
  }
  .top-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    flex: 1;
  }
  .top-nav a {
    color: var(--sl-color-gray-2);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    padding: 0.48rem 0.62rem;
    border-radius: 0.5rem;
    transition:
      color 0.2s,
      background 0.2s;
  }
  .top-nav a:hover {
    color: #ddd6fe;
    background: #1a1028;
    box-shadow: inset 0 0 0 1px #7c3aed45;
  }
  .header-tools {
    align-items: center;
    gap: 0.8rem;
  }
  .social-icons {
    gap: 0.75rem;
    padding-left: 0.8rem;
    border-left: 1px solid #2b2038;
  }
  @media (max-width: 72rem) {
    .top-nav {
      gap: 0;
    }
    .top-nav a {
      padding-inline: 0.4rem;
      font-size: 0.76rem;
    }
  }
  @media (max-width: 50rem) {
    .top-nav {
      display: none;
    }
    .docs-header {
      justify-content: space-between;
    }
    .header-tools {
      margin-left: auto;
    }
  }
</style>
