{
  "name": "@chamn/layout",
  "version": "0.12.4",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module-sync": "./dist/index.es.js",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./debug": {
      "types": "./dist/components/LayoutDebug/index.d.ts",
      "module-sync": "./dist/debug.es.js",
      "import": "./dist/debug.es.js",
      "require": "./dist/debug.cjs.js"
    },
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "start": "build-script",
    "build": "pnpm run build:main && pnpm run build:debug",
    "build:main": "cross-env BUILD_ENTRY=main build-script --build",
    "build:debug": "cross-env BUILD_ENTRY=debug build-script --build",
    "build:analyze": "build-script --build --analyze",
    "build:w": "build-script --build --watch",
    "lint": "eslint --ext .tsx,.ts src/",
    "prettier": "prettier --write ./src",
    "test": "jest"
  },
  "peerDependencies": {
    "react": ">=16.9.0",
    "react-dom": ">=16.9.0"
  },
  "dependencies": {
    "@chamn/model": "workspace:*",
    "@chamn/render": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "lodash-es": "^4.17.21",
    "mitt": "^3.0.0"
  },
  "devDependencies": {
    "@chamn/build-script": "workspace:*",
    "@chamn/demo-page": "workspace:*",
    "@types/lodash-es": "^4.17.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.0.6",
    "antd": "^5.23.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.54.0"
  },
  "config": {},
  "gitHead": "dc3e55fdeb903a8012f6ebd3ebc018ed61ad89db"
}
